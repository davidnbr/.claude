{
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "OMC_DISABLE_TOOLS": "wiki,memory"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(./.env.example)",
      "Read(./credentials.example.json)",
      "Read(./secrets.example.json)",
      "Read(./.dev.vars.example)",
      "Read",
      "Grep",
      "Glob",
      "WebSearch"
    ],
    "deny": [
      "WebFetch",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Read(./.env.ci)",
      "Read(./.env.docker)",
      "Read(./.env.backup)",
      "Read(./.env.bak)",
      "Read(./.env.old)",
      "Read(./credentials.json)",
      "Read(./secrets.json)",
      "Read(./secrets.local.json)",
      "Read(./secrets.development.json)",
      "Read(./secrets.test.json)",
      "Read(./secrets.production.json)",
      "Read(./secrets.staging.json)",
      "Read(./secrets.backup.json)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(./config/credentials.json)",
      "Read(./Cargo.lock)",
      "Read(./secrets/**)",
      "Read(/proc/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Bash(env)",
      "Bash(env|*)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(export -p)",
      "Bash(export -p|*)",
      "Bash(declare -x)",
      "Bash(declare -x|*)",
      "Bash(declare -p)",
      "Bash(declare -p|*)",
      "Bash(set)",
      "Bash(compgen -v:*)",
      "Bash(cat /proc/*/environ)",
      "Bash(cat /proc/*/environ:*)",
      "Bash(*/proc/*/environ*)",
      "Bash(*$AWS_SECRET*)",
      "Bash(*$AWS_ACCESS_KEY*)",
      "Bash(*$GITHUB_TOKEN*)",
      "Bash(*$OPENAI_API_KEY*)",
      "Bash(*$ANTHROPIC_API_KEY*)",
      "Read(../**)",
      "Read(/etc/**)",
      "Read(/root/**)",
      "Edit(../**)",
      "Edit(/etc/**)",
      "Edit(/root/**)",
      "Edit(/usr/**)",
      "Edit(/bin/**)",
      "Edit(../**)",
      "Edit(/etc/**)",
      "Edit(/root/**)",
      "Edit(/usr/**)",
      "Edit(/bin/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Read(~/.claude/.omc-config.json)",
      "Read(/home/dbecerra/.claude/.omc-config.json)",
      "Edit(~/.claude/.omc-config.json)",
      "Edit(~/.claude/.omc-config.json)",
      "Bash(*omc-config.json*)",
      "Bash(*.omc-config*)",
      "Read(/home/davidnbr98/.claude/.omc-config.json)",
      "Edit(/home/davidnbr98/.claude/.omc-config.json)",
      "Edit(/home/davidnbr98/.claude/.omc-config.json)",
      "Read(/home/davidnbr98/.claude.json)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm --recursive --force*)",
      "Bash(rm --force --recursive*)",
      "Bash(* rm -rf *)",
      "Bash(* rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push --force-with-lease*)",
      "Bash(git --git-dir=* push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git -C * clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git -C * branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git -C * checkout -- *)",
      "Bash(echo $*)",
      "Bash(printf *$*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.netrc)",
      "Bash(cat /etc/*)",
      "Bash(cd ~/*)",
      "Bash(cd ..*)",
      "Bash(rm /*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/strip-omc-memory-hooks.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/rtk hook claude"
          },
          {
            "type": "command",
            "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/block-secret-leak.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/spec-gates.sh",
            "timeout": 15,
            "statusMessage": "Checking spec-driven delivery gates"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/reporag-dupcheck.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "reporag",
            "tool": "index_codebase",
            "input": {
              "path": "${cwd}"
            }
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/reporag-hint.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/slack-notify-stop.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/slack-notify.sh \"🔔 Action needed\""
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "ralph-loop@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "oh-my-claudecode@omc": true,
    "pyright-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "gopls-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "0.0.0.0",
        "::1"
      ],
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/nc",
        "~/nd"
      ],
      "denyWrite": [
        "./.git"
      ]
    },
    "bwrapPath": "/usr/bin/bwrap"
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
