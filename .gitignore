# Allowlist: ignore everything at the top level, then name what this repo shares.
# Claude Code and company policy add runtime files over time; they stay ignored by default.
/*
!/.gitignore
!/CLAUDE.md
!/RTK.md
!/.mcp.json
!/settings.json
!/agents/
!/commands/
!/docs/
!/hooks/
!/rules/
!/scripts/
!/skills/

# Inside shared folders
/skills/synced/
/skills/.trash/
hooks/reporag-*
.caveman-*
__pycache__/
*.log

# Secrets and backups, wherever they sit
.credentials*
*.pem*
*.key*
*.keys*
*.backup.*
**/*.bak
**/*.bak.*
*-cache.json
.session-stats.json
ledger-backups/
